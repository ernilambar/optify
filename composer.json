{
	"name": "ernilambar/optify",
	"description": "A flexible WordPress panel system for React-based options",
	"keywords": [
		"wordpress",
		"options",
		"settings",
		"panel",
		"react",
		"rest-api"
	],
	"homepage": "https://github.com/ernilambar/optify",
	"license": "MIT",
	"type": "library",
	"authors": [
		{
			"name": "Nilambar Sharma",
			"email": "nilambar@outlook.com",
			"homepage": "https://www.nilambar.net/",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/ernilambar/optify/issues",
		"source": "https://github.com/ernilambar/optify"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"ernilambar/coding-standard": "^2.0",
		"php-parallel-lint/php-parallel-lint": "dev-develop#f8cb90a",
		"phpcompatibility/php-compatibility": "^10.0",
		"slevomat/coding-standard": "^8.22",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Nilambar\\Optify\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true
	},
	"extra": {
		"branch-alias": {
			"dev-main": "1.x-dev"
		}
	},
	"scripts": {
		"format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
		"lint": [
			"@lint-php",
			"@phpcs"
		],
		"lint-php": "@php ./vendor/bin/parallel-lint --colors --exclude .git --exclude vendor .",
		"phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary"
	}
}
