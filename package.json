{
	"name": "optify",
	"version": "1.0.1",
	"private": true,
	"description": "A flexible WordPress panel system for React-based options",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"options-panel",
		"settings",
		"react",
		"rest-api"
	],
	"homepage": "https://github.com/ernilambar/optify#readme",
	"bugs": {
		"url": "https://github.com/ernilambar/optify/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ernilambar/optify.git"
	},
	"license": "MIT",
	"author": "Nilambar Sharma <nilambar@outlook.com> (https://www.nilambar.net/)",
	"scripts": {
		"build": "wp-scripts build",
		"dev": "wp-scripts start",
		"format": "wp-scripts format && pnpm run format:css",
		"format:css": "prettier \"**/*.{css,scss}\" --write --log-level warn",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	},
	"browserslist": "> 2%, last 2 versions, not dead",
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@wordpress/components": "^40.1.0",
		"@wordpress/i18n": "^6.28.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@wordpress/prettier-config": "^4.27.0",
		"@wordpress/scripts": "^35.0.0",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^10.2.4",
		"prettier": "npm:wp-prettier@^3.0.3"
	},
	"engines": {
		"node": ">=22.13.0"
	}
}
